{
    "tasks": [
        {
            "type": "cppbuild",
            "label": "C/C++: g++.exe build Racko.exe",
            "command": "C:\\msys64\\ucrt64\\bin\\g++.exe",
            "args": [
                "-fdiagnostics-color=always",
                "-g",
                "${fileDirname}\\..\\src\\*.cpp",
                "-o",
                "${fileDirname}\\..\\bin\\Racko.exe"
            ],
            "options": {
                "cwd": "${fileDirname}\\..\\src"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build"
            },
            "detail": "Task generated by Debugger."
        },
        {
            "label": "Build with make",
            "type": "cppbuild",
            "command": "C:\\msys64\\msys2_shell.cmd",
            "args": [
                "-mingw64",
                "-defterm",
                "-no-start",
                "-here",
                "-c",
                "make DEBUG=-g build"
            ],
            "group": {
                "kind": "build",
                "isDefault": false
            },
            "problemMatcher": {
                "owner": "cpp",
                "fileLocation": [
                    "relative",
                    "${workspaceFolder}"
                ],
                "pattern": {
                    "regexp": "^(.*):(\\d+):(\\d+):\\s+(warning|error):\\s+(.*)$",
                    "file": 1,
                    "line": 2,
                    "column": 3,
                    "severity": 4,
                    "message": 5
                }
            }
        },
        {
            "label": "Build tests with make",
            "type": "cppbuild",
            "command": "C:\\msys64\\msys2_shell.cmd",
